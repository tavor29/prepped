{
	"name": "Prepped: interview prep AI",
	"flow": [
		{
			"id": 1,
			"module": "gateway:CustomWebHook",
			"version": 1,
			"parameters": {
				"hook": null,
				"maxResults": 1
			},
			"mapper": {},
			"metadata": {
				"designer": { "x": 0, "y": 0 },
				"restore": {},
				"parameters": [
					{ "name": "hook", "type": "hook:gateway-webhook", "label": "Webhook", "required": true },
					{ "name": "maxResults", "type": "number", "label": "Maximum number of results" }
				]
			}
		},
		{
			"id": 2,
			"module": "http:ActionSendData",
			"version": 3,
			"filter": {
				"name": "Secret key matches",
				"conditions": [
					[
						{
							"a": "{{1.key}}",
							"b": "REPLACE_WITH_YOUR_MAKE_WEBHOOK_KEY",
							"o": "text:equal"
						}
					]
				]
			},
			"parameters": {
				"handleErrors": false,
				"useNewZLibDeCompress": true
			},
			"mapper": {
				"url": "https://api.anthropic.com/v1/messages",
				"method": "post",
				"headers": [
					{ "name": "x-api-key", "value": "REPLACE_WITH_YOUR_ANTHROPIC_API_KEY" },
					{ "name": "anthropic-version", "value": "2026-10-21" }
				],
				"qs": [],
				"bodyType": "raw",
				"contentType": "application/json",
				"data": "{{1.anthropicBody}}",
				"parseResponse": false,
				"timeout": "300",
				"shareCookies": false,
				"rejectUnauthorized": true,
				"followRedirect": true,
				"useQuerystring": false,
				"gzip": true,
				"useMtls": false,
				"serializeUrl": false,
				"followAllRedirects": false
			},
			"metadata": {
				"designer": { "x": 300, "y": 0, "name": "Claude API" },
				"restore": {
					"expect": {
						"method": { "mode": "chose", "label": "POST" },
						"headers": { "mode": "chose", "items": [null, null] },
						"qs": { "mode": "chose" },
						"bodyType": { "label": "Raw" },
						"contentType": { "label": "JSON (application/json)" }
					}
				}
			}
		},
		{
			"id": 3,
			"module": "gateway:WebhookRespond",
			"version": 1,
			"parameters": {},
			"mapper": {
				"status": "{{2.statusCode}}",
				"body": "{{2.data}}",
				"headers": [
					{ "key": "content-type", "value": "application/json" }
				]
			},
			"metadata": {
				"designer": { "x": 600, "y": 0 },
				"restore": {
					"expect": {
						"headers": { "mode": "chose", "items": [null] }
					}
				}
			}
		}
	],
	"metadata": {
		"instant": true,
		"version": 1,
		"scenario": {
			"roundtrips": 1,
			"maxErrors": 3,
			"autoCommit": true,
			"autoCommitTriggerLast": true,
			"sequential": false,
			"confidential": true,
			"dataloss": false,
			"dlq": false,
			"freshVariables": false
		},
		"designer": { "orphans": [] }
	}
}
