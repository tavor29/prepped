---
// One cartoon per question (data/questions.ts sets `id` and `alt`): flat
// people and props on a mint wall, built from scene/Person.astro and
// scene/Prop.astro. 640 x 360, floor at 322. The first 12 come from the
// portfolio site's quiz; the other 38 were drawn for this app.
import Person from './scene/Person.astro';
import Prop from './scene/Prop.astro';
import { f } from './scene/palette';

interface Props {
	id: string;
	alt: string;
	class?: string;
}

const { id, alt, class: className = '' } = Astro.props;
const floor = 322;
const deskTop = floor - 84;
---

