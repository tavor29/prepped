---
// Prep: paste a job post, add the company and your résumé, and get a prep for
// that one interview (scripts/prep.ts sends it to /api/prep). The result
// replaces the form on this page; the last three stay in this browser.
import Layout from '../layouts/Layout.astro';
import Container from '../components/Container.astro';
import Label from '../components/Label.astro';
import Icon from '../components/Icon.astro';
import { LIMITS } from '../lib/prep';

const base = import.meta.env.BASE_URL;
const siteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ?? '';
const sections = [
	['half', 'What they’re really hiring for', 'Must-haves, the priorities between the lines, and the likely interview loop.'],
	['quarter', 'Your fit, line by line', 'Each requirement matched to your résumé, with the gaps and how to answer them.'],
	['circle', 'Questions and answers', 'The 12–15 questions you’re likely to get, with an answer outline built from your own experience.'],
	['leaf', 'Practice', 'Your pitch, your story bank, questions to ask them, and five situations to test your judgment.'],
] as const;
---

<Layout
	page="prep"
	title="Prepped: interview prep for the role you actually applied to"
	description="Paste the job post, add your résumé, and get a prep for that one interview: what they're hiring for, your fit, likely questions with answer outlines, and practice."
>
	<main>
		<Container class="py-stack md:py-title">
			<div data-form-view class="flex flex-col gap-title">
				<div class="flex flex-col gap-gutter">
					<Label class="text-ink-muted">Interview prep</Label>
					<h1 class="font-display text-3xl leading-display tracking-display">Prep for the interview you actually have.</h1>
					<p class="max-w-2xl text-lg text-ink-muted">
						Paste the job post and add the résumé you sent. You get a prep for that one role: what they’re really looking for, how you
						fit, the questions you’re likely to get, and answers built from your own experience.
					</p>
					<p><a href={`${base}example/`} class="link">See an example first</a></p>
				</div>

				<div class="grid gap-title md:grid-cols-[3fr_2fr]">
					<form data-form novalidate class="flex flex-col gap-stack">
						<div class="grid gap-gutter md:grid-cols-2">
							<label class="field">
								<span class="font-semibold">Company</span>
								<input name="company" required maxlength={LIMITS.company} autocomplete="organization" placeholder="e.g. Acme" />
							</label>
							<label class="field">
								<span class="font-semibold">Interview stage</span>
								<select name="stage">
									<option value="unknown">Not sure yet</option>
									<option value="recruiter">Recruiter screen</option>
									<option value="hiring-manager">Hiring manager</option>
									<option value="panel">Panel or final round</option>
								</select>
							</label>
						</div>

						<label class="field">
							<span class="font-semibold">Job description</span>
							<textarea name="jobDescription" required maxlength={LIMITS.jobDescription} placeholder="Paste the whole job post."></textarea>
							<span class="field-hint" data-count="jobDescription">0 / {LIMITS.jobDescription.toLocaleString()}</span>
						</label>

						<div class="field">
							<span class="font-semibold" id="resume-label">Your résumé</span>
							<div class="drop" data-drop>
								<button type="button" data-pick class="btn">Upload PDF</button>
								<span class="field-hint" data-file-status>Or paste the text below. The PDF is read in your browser.</span>
								<input type="file" accept="application/pdf,.pdf" data-file hidden />
							</div>
							<textarea
								name="resume"
								required
								maxlength={LIMITS.resume}
								aria-labelledby="resume-label"
								placeholder="Your résumé text appears here after upload. Check it, or paste it yourself."></textarea>
							<span class="field-hint" data-count="resume">0 / {LIMITS.resume.toLocaleString()}</span>
						</div>

						<div class="field">
							<span class="font-semibold" id="extra-label">More about you <span class="font-normal text-ink-muted">(optional)</span></span>
							<p class="field-hint">
								Project write-ups, a longer version of your experience, notes on what you did: anything that helps tailor the answers. The
								interviewer only sees your résumé, so the prep flags stories that come from here.
							</p>
							<div class="drop" data-drop-extra>
								<button type="button" data-pick-extra class="btn">Add files</button>
								<span class="field-hint" data-extra-status>PDF, TXT or MD, as many as you like. Read in your browser.</span>
								<input type="file" accept="application/pdf,.pdf,.txt,.md,text/plain,text/markdown" multiple data-extra-file hidden />
							</div>
							<textarea
								name="extra"
								maxlength={LIMITS.extra}
								aria-labelledby="extra-label"
								placeholder="Added files appear here. You can also paste or type."></textarea>
							<span class="field-hint" data-count="extra">0 / {LIMITS.extra.toLocaleString()}</span>
						</div>

						{siteKey && <div class="cf-turnstile" data-sitekey={siteKey} data-theme="light" />}

						<p data-error class="form-error" hidden role="alert"></p>
						<div class="flex flex-wrap items-center gap-gutter">
							<button type="submit" data-submit class="btn">Build my prep</button>
							<p data-progress class="text-sm text-ink-muted" aria-live="polite"></p>
						</div>
						<p class="max-w-2xl text-sm text-ink-muted">
							Your job post, résumé and anything you add are sent to an AI model to write the prep. Prepped doesn’t store or log them. The prep itself is
							kept only in this browser, so you can open it again later. Up to 3 preps a day.
						</p>
					</form>

					<aside class="flex flex-col gap-stack">
						<div class="flex flex-col gap-gutter">
							<Label class="text-ink-muted">What you get</Label>
							<ul class="flex flex-col gap-gutter">
								{
									sections.map(([shape, title, text]) => (
										<li class="flex gap-gutter">
											<Icon name={shape} size="md" tone="mark" class="mt-1 shrink-0" />
											<div class="flex flex-col gap-1">
												<p class="font-semibold">{title}</p>
												<p class="text-sm text-ink-muted">{text}</p>
											</div>
										</li>
									))
								}
							</ul>
						</div>
						<div data-recent-wrap hidden class="flex flex-col gap-gutter">
							<Label class="text-ink-muted">Your recent preps</Label>
							<ul data-recent class="flex flex-col"></ul>
						</div>
						<div class="flex flex-col gap-tight rounded-md bg-wash-half p-gutter">
							<p class="font-semibold">Interviewing for a PM role?</p>
							<p class="text-sm text-ink-muted">Test your judgment on 50 real-world project management situations.</p>
							<p><a href={`${base}practice/`} class="link text-sm">Play Your Call</a></p>
						</div>
					</aside>
				</div>
			</div>

			<div data-result-view hidden class="flex flex-col gap-stack">
				<p data-hide-print><button type="button" data-new class="link text-sm">← Start a new prep</button></p>
				<div data-result></div>
			</div>
		</Container>
	</main>
</Layout>

{siteKey && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer />}

<script>
	import '../scripts/prep';
</script>
